{
  "name": "@zappaz/zappaz-mastra",
  "version": "0.1.0-beta.1",
  "description": "Integração entre agentes Mastra e WhatsApp via Zappaz Lite, com debounce, tools e atendimento humano.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viiniolliveira/zappaz-mastra.git"
  },
  "homepage": "https://github.com/viiniolliveira/zappaz-mastra#readme",
  "bugs": { "url": "https://github.com/viiniolliveira/zappaz-mastra/issues" },
  "keywords": ["zappaz", "mastra", "whatsapp", "agents", "typescript"],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run typecheck && bun test src && bun run build"
  },
  "peerDependencies": {
    "@mastra/core": "^1.82.0",
    "@zappaz/zappaz-lite-sdk": "^0.3.0"
  },
  "dependencies": { "zod": "^4.6.7" },
  "devDependencies": {
    "@mastra/core": "1.82.0",
    "@zappaz/zappaz-lite-sdk": "0.3.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
